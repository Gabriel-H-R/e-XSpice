# Ignorar a pasta de compilação do CMake
build/
out/
bin/

# Ignorar arquivos compilados e temporários gerais de C/C++
*.o
*.obj
*.exe
*.dll
*.lib
*.a
*.so
*.dylib

# Ignorar configurações locais da sua IDE (ex: VS Code)
.vscode/

# Ignorar arquivos de log que podem ser gerados
*.log
# Saida padrao do executavel (artefato de execucao)
simulation_output.csv
out*.csv
test_*.csv

# Artefatos intermediarios de compilacao LaTeX (doc/mathematical/report)
doc/**/*.aux
doc/**/*.auxlock
doc/**/*.fls
doc/**/*.fdb_latexmk
doc/**/*.lof
doc/**/*.out
doc/**/*.synctex.gz
doc/**/*.toc
doc/**/*.xdv
doc/**/*.tdo
doc/**/*-figure*.md5

# Pasta de anotacoes temporarias
temp/
